PORT=
AWS_REGION=

WORKFLOWS=
TALLYCONNECTIONS=
USERS=

STATE_MACHINE_ROLE_ARN=
SCHEDULER_ROLE_ARN=

NOTIFICATION_LAMBDA_ARN=

SES_FROM_EMAIL=

# Google OAuth — the frontend's Google Sign-In button posts an ID token here
# for verification. Only the Client ID is needed (no client secret): this is
# the "verify an ID token" flow, not a server-side authorization-code exchange.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Needed for CORS + cookies: the deployed frontend origin, no trailing slash.
# The old cors() with no options allowed any origin but can't be combined
# with credentialed (cookie-based) requests — this replaces that.
FRONTEND_URL=http://localhost:5173
